#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

// Replace with your network credentials
const char* ssid = "5G";
const char* password = "NE555LM358";

ESP8266WebServer server(80);

// Motor Pins (L298N)
int IN1 = 5; // Right Motors Forward
int IN2 = 4; // Right Motors Backward
int IN3 = 0; // Left Motors Forward
int IN4 = 2; // Left Motors Backward

// HTML Web Page
const char index_html[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
    <title>NodeMCU 4WD Control</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        .button { background-color: #4CAF50; border: none; color: white; padding: 20px; 
                  text-align: center; display: inline-block; font-size: 20px; margin: 10px; cursor: pointer; 
                  width: 100px; user-select: none; -webkit-user-select: none; }
        .stop { background-color: #f44336; }
    </style>
</head>
<body>
    <center>
        <h1>4WD WiFi Control</h1>
        <button class="button" onmousedown="send('/forward')" onmouseup="send('/stop')" ontouchstart="send('/forward')" ontouchend="send('/stop')">Forward</button><br>
        <button class="button" onmousedown="send('/left')" onmouseup="send('/stop')" ontouchstart="send('/left')" ontouchend="send('/stop')">Left</button>
        <button class="button" onmousedown="send('/right')" onmouseup="send('/stop')" ontouchstart="send('/right')" ontouchend="send('/stop')">Right</button><br>
        <button class="button" onmousedown="send('/backward')" onmouseup="send('/stop')" ontouchstart="send('/backward')" ontouchend="send('/stop')">Backward</button>
    </center>
    <script>
        function send(path) {
            var xhr = new XMLHttpRequest();
            xhr.open("GET", path, true);
            xhr.send();
        }
    </script>
</body>
</html>
)rawliteral";

void handleRoot() { server.send(200, "text/html", index_html); }

void stopRobot() {
  digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
}

void setup() {
  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);
  stopRobot();

  Serial.begin(115200);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
  
  Serial.println("\nWiFi connected");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.on("/forward", []() { digitalWrite(IN1, HIGH); digitalWrite(IN3, HIGH); server.send(200); });
  server.on("/backward", []() { digitalWrite(IN2, HIGH); digitalWrite(IN4, HIGH); server.send(200); });
  server.on("/left", []() { digitalWrite(IN2, HIGH); digitalWrite(IN3, HIGH); server.send(200); });
  server.on("/right", []() { digitalWrite(IN1, HIGH); digitalWrite(IN4, HIGH); server.send(200); });
  server.on("/stop", []() { stopRobot(); server.send(200); });

  server.begin();
}

void loop() {
  server.handleClient();
}
